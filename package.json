{
    "name": "screeps-arena-tools",
    "version": "0.1.0",
    "type": "module",
    "description": "Fetch, normalize and view Screeps: Arena match replays",
    "license": "GPL-3.0-or-later",
    "engines": {
        "node": ">=20"
    },
    "bin": {
        "arena-tools": "dist/src/cli.js"
    },
    "exports": {
        ".": {
            "types": "./dist/src/index.d.ts",
            "import": "./dist/src/index.js"
        },
        "./normalize": {
            "types": "./dist/src/normalize.d.ts",
            "import": "./dist/src/normalize.js"
        },
        "./timeline": {
            "types": "./dist/src/timeline.d.ts",
            "import": "./dist/src/timeline.js"
        }
    },
    "files": [
        "dist",
        "viewer",
        "examples",
        "docs",
        "README.md"
    ],
    "scripts": {
        "build": "tsc",
        "typecheck": "tsc --noEmit",
        "test": "npm run build && node --test dist/test/*.test.js",
        "view": "npm run build && node dist/src/cli.js view",
        "fetch": "npm run build && node dist/src/cli.js fetch"
    },
    "keywords": [
        "screeps",
        "screeps-arena",
        "replay",
        "viewer"
    ],
    "devDependencies": {
        "@types/node": "^26.2.0",
        "typescript": "^5.9.3"
    }
}
